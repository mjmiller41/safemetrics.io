{
  // The root tsconfig only includes `src`, so the Cloudflare Worker was never
  // typechecked. This config covers `worker/` using the ambient runtime shapes in
  // worker/env.d.ts. Run with `npm run typecheck:worker`.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["worker"]
}
