{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "safemetrics-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  // The built SPA is served straight from the edge and does NOT count against
  // the Worker request limit. `run_worker_first` sends only /api/* to our code.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Clerk Frontend API origin. Public (it is in every browser request), so it is a
  // var rather than a secret. While it is empty the worker rejects every
  // authenticated request with 503 instead of trusting unverified tokens.
  "vars": {
    "CLERK_ISSUER": "https://noted-civet-6994.clerk.accounts.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "safemetrics-db",
      "database_id": "a21dff63-dc96-49b3-8d5a-b62353dcbfbc"
    }
  ],

  // Binds the Worker to the apex domain from version control rather than the
  // dashboard. Without this the custom domain has to be attached by hand, which
  // is how safemetrics.io ended up served by a stale Pages project instead.
  "routes": [{ "pattern": "safemetrics.io", "custom_domain": true }],

  "observability": { "enabled": true }
}
